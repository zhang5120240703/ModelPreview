# 腾讯官方 TokenHub API Key；不是腾讯云 CAM 的 SecretId/SecretKey，也不是 fal Key。
PROVIDER=hunyuan
HUNYUAN_API_KEY=
HUNYUAN_MODEL=hy-3d-3.1
# Normal 模式有颜色纹理。PBR 和自定义面数可能增加费用，先保留默认。
HUNYUAN_ENABLE_PBR=false
# 仅当需要调整面数时填写，例如 30000；留空请删除或注释该行。
# HUNYUAN_FACE_COUNT=30000
PUBLIC_BASE_URL=http://127.0.0.1:8000
# 单图本机直接可用。多图需提供公网 HTTPS 入口，仅反代签名图片 GET 路由。
HUNYUAN_IMAGE_BASE_URL=
HUNYUAN_MODEL_DOWNLOAD_HOSTS=hunyuan-prod-1258344699.cos.ap-guangzhou.tencentcos.cn
DATA_DIR=./data
POLL_INTERVAL_SECONDS=5
TASK_TIMEOUT_SECONDS=1800
MAX_IMAGE_MB=4
MAX_MODEL_MB=64
CORS_ORIGINS=

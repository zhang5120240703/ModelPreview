PROVIDER=mock
# Absolute public URL, reachable by the intended client. No trailing /.
PUBLIC_BASE_URL=http://127.0.0.1:8000
DATA_DIR=./data
MOCK_DELAY_SECONDS=2
MESHY_API_KEY=
MESHY_AI_MODEL=latest
FAL_KEY=
FAL_MODEL_DOWNLOAD_HOSTS=v3.fal.media,v3b.fal.media
HUNYUAN_API_KEY=
HUNYUAN_MODEL=hy-3d-3.1
HUNYUAN_ENABLE_PBR=false
# HUNYUAN_FACE_COUNT=30000
HUNYUAN_IMAGE_BASE_URL=
HUNYUAN_MODEL_DOWNLOAD_HOSTS=hunyuan-prod-1258344699.cos.ap-guangzhou.tencentcos.cn
GITHUB_UPLOAD_ENABLED=false
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_BRANCH=main
GITHUB_PAGES_BASE_URL=
GITHUB_UPLOAD_PATH=github-pages-images/uploads
GITHUB_PUBLISH_TIMEOUT_SECONDS=1200
GITHUB_PUBLISH_POLL_SECONDS=15
POLL_INTERVAL_SECONDS=5
TASK_TIMEOUT_SECONDS=1800
MAX_IMAGE_MB=10
MAX_MODEL_MB=64
MODEL_DOWNLOAD_HOSTS=assets.meshy.ai
# Comma separated browser origins; empty means no cross-origin browser access.
CORS_ORIGINS=
